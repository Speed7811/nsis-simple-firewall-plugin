    </Target>
    <Target Name="Build">
        <CallTarget Targets="SimpleFC"/>
    </Target>
    <Target Name="Clean">
        <CallTarget Targets="SimpleFC:Clean"/>
    </Target>
    <Target Name="Make">
        <CallTarget Targets="SimpleFC:Make"/>
